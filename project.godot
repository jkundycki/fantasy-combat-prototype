; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Movement Sandbox"
run/main_scene="res://sandbox/arena.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"

[input]

bot_personality={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194335)]}
bot_mode={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194337)]}


weapon_switch={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":81),Object(InputEventJoypadButton,"device":-1,"button_index":3)]}


heavy={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69),Object(InputEventJoypadMotion,"device":-1,"axis":5,"axis_value":1.0)]}
cancel_feint={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":82),Object(InputEventJoypadButton,"device":-1,"button_index":8)]}
special={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":70),Object(InputEventJoypadButton,"device":-1,"button_index":10)]}
camera_facing={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":2)]}
defense={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194326,"location":1),Object(InputEventJoypadButton,"device":-1,"button_index":9)]}
look_left={"deadzone":0.15,"events":[Object(InputEventJoypadMotion,"device":-1,"axis":2,"axis_value":-1.0)]}
look_right={"deadzone":0.15,"events":[Object(InputEventJoypadMotion,"device":-1,"axis":2,"axis_value":1.0)]}
look_up={"deadzone":0.15,"events":[Object(InputEventJoypadMotion,"device":-1,"axis":3,"axis_value":-1.0)]}
look_down={"deadzone":0.15,"events":[Object(InputEventJoypadMotion,"device":-1,"axis":3,"axis_value":1.0)]}


primary={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":1),Object(InputEventJoypadButton,"device":-1,"button_index":2)]}
combat_debug={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194334)]}


move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":-1.0)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":1.0)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":-1.0)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":1.0)]}
jump={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32),Object(InputEventJoypadButton,"device":-1,"button_index":0)]}
mobility={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194325,"location":1),Object(InputEventJoypadButton,"device":-1,"button_index":1)]}

[physics]

common/physics_ticks_per_second=120

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055, 0.075, 0.12, 1)
